# Used by Docker Compose interpolation. No config.json is required in env mode.
VENERA_CATALOG_URL=https://raw.githubusercontent.com/yuxuanmian/venera-configs/yxm/index.json
VENERA_BIND_IP=127.0.0.1
VENERA_PORT=8080

# Only used with compose.config.yml; file must already exist.
VENERA_CONFIG_PATH=./config.example.json
